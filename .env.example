# Base URL của BE. Ở dev = "/api" (qua Vite proxy, bypass CORS).
# Ở production = full URL của BE (BE phải whitelist CORS domain FE).
VITE_API_BASE_URL=/api

# DEV-ONLY: set "true" to show the Telegram token/chat_id section in the
# Launchpad modal (lets the team test a bot via Telegram). Default off; never
# set in production. Put VITE_TELEGRAM_DEV=true in .env.local to enable.
VITE_TELEGRAM_DEV=
