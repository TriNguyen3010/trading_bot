# Base URL của BE. Ở dev = "/api" (qua Vite proxy, bypass CORS).
# Ở production = full URL của BE (BE phải whitelist CORS domain FE).
VITE_API_BASE_URL=/api

# Optional default Telegram bot token shown in the Live launch modal.
# Users still enter Telegram Chat ID per launch; leave empty to type both fields.
VITE_TELEGRAM_BOT_TOKEN=
